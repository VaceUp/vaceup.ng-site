# VaceUp LMS — environment template. Copy to `.env` and fill in.
# See GO-LIVE.md for which vars are required. Never commit the real .env.

# ---- Core (required) ----
SECRET_KEY=generate-a-64-char-random-string
DEBUG=False
ALLOWED_HOSTS=api.vaceup.ng,vaceup.ng
JWT_SIGNING_KEY=generate-another-random-string
SECURE_SSL_REDIRECT=True

# ---- Database (required) ----
DB_NAME=vaceup
DB_USER=vaceup
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- CORS (required) ----
CORS_ALLOWED_ORIGINS=https://vaceup.ng

# ---- Email (required for verification/reset; blank = console backend) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=VaceUp <no-reply@vaceup.ng>
FRONTEND_BASE_URL=https://vaceup.ng

# ---- Cache / throttle store (required for scale) ----
REDIS_URL=

# ---- Celery: async email + live-class reminders (broker defaults to REDIS_URL) ----
# Prod: run `celery -A config worker` and `celery -A config beat`.
# Dev without a worker: CELERY_TASK_ALWAYS_EAGER=True runs tasks inline.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False
LIVE_CLASS_REMINDER_LEAD_MINUTES=30

# ---- Error monitoring (recommended) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.10

# ---- Media storage: AWS S3 or Cloudflare R2 ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=vaceup-media
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_ENDPOINT_URL=          # set for Cloudflare R2 (S3-compatible)

# ---- Payments: Paystack (required for paid courses) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://vaceup.ng/payment/callback
PAYMENT_CURRENCY=NGN

# ---- Live classes: LiveKit (optional; "external" link provider needs no keys) ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=
LIVE_CLASS_JOIN_EARLY_MINUTES=10
LIVE_CLASS_JOIN_GRACE_MINUTES=15

# ---- Not wired yet ----
CLOUDINARY_URL=
