# VaceUp LMS — environment template. Copy to `.env` and fill in.
# See GO-LIVE.md for which vars are required. Never commit the real .env.

# ---- Core (required) ----
SECRET_KEY=generate-a-64-char-random-string
DEBUG=False
ALLOWED_HOSTS=api.vaceup.ng,vaceup.ng
JWT_SIGNING_KEY=generate-another-random-string
SECURE_SSL_REDIRECT=True
# Path of the Django staff login, written without slashes: api.vaceup.ng/admin/
# A leading slash here used to make the page unreachable at every address.
ADMIN_URL=admin

# ---- Database (required) ----
DB_NAME=vaceup
DB_USER=vaceup
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- CORS (required) ----
CORS_ALLOWED_ORIGINS=https://vaceup.ng
# Hosts allowed to POST forms (Django admin). Mirror CORS origins + API host.
CSRF_TRUSTED_ORIGINS=https://vaceup.ng

# ---- Email: the hosting account's own local relay (TrueHost / cPanel) ----
# The bundled mail server listens on 127.0.0.1 port 25 and relays for domains
# hosted on this account, so there are no credentials and no TLS on this path.
# Selecting apps.accounts.local_smtp.EmailBackend is the explicit opt-in; that
# backend refuses any host other than loopback port 25 and refuses credentials,
# so it cannot quietly downgrade a remote SMTP setup to plaintext.
# For a remote provider instead: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# with that provider's encrypted host, port, user and password.
EMAIL_BACKEND=apps.accounts.local_smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
# The sender must be a real mailbox on the hosting account or the relay refuses it.
DEFAULT_FROM_EMAIL=VaceUp <no-reply@vaceup.ng>
SERVER_EMAIL=VaceUp <no-reply@vaceup.ng>
# cPanel runs no persistent worker: keep mail in the database outbox and let a
# cron job run manage.py process_mail_queue.
VACEUP_INFRASTRUCTURE=database
ACCOUNT_EMAIL_DELIVERY_MODE=database
FRONTEND_BASE_URL=https://vaceup.ng

# ---- Cache / throttle store (required for scale) ----
REDIS_URL=

# ---- Celery: async email + live-class reminders (broker defaults to REDIS_URL) ----
# Prod: run `celery -A config worker` and `celery -A config beat`.
# Dev without a worker: CELERY_TASK_ALWAYS_EAGER=True runs tasks inline.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False
LIVE_CLASS_REMINDER_LEAD_MINUTES=30

# ---- Error monitoring (recommended) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.10

# ---- Public images: Cloudinary (covers, team photos, event covers) ----
# Highest priority for public images. Leave CLOUDINARY_URL blank to keep them
# on the bucket below, or blank there too to keep them on local disk.
# Copy the whole line from the Cloudinary dashboard. Anything after "=" is read
# as the value, so never put a comment on these lines.
CLOUDINARY_URL=
# Folder prefix inside the Cloudinary account.
CLOUDINARY_FOLDER=vaceup
# Only if Cloudinary gives you your own delivery hostname; leave blank otherwise.
CLOUDINARY_SECURE_DISTRIBUTION=

# ---- Private media: one S3-compatible bucket (Cloudflare R2 or AWS S3) ----
# Lesson videos, live-class recordings, certificate PDFs. Set the bucket name
# and both keys together: a bucket without keys makes every upload fail, and
# anything after "=" is read as the value, so keep examples on comment lines.
# R2:  AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
#      with AWS_S3_REGION_NAME=auto, and leave AWS_S3_CUSTOM_DOMAIN blank so
#      pre-signed URLs stay on the endpoint host they were signed for.
# AWS: leave AWS_S3_ENDPOINT_URL blank with AWS_S3_REGION_NAME=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
# Optional hostname that serves PUBLIC objects from the bucket (e.g.
# media.vaceup.ng). Private files ignore it: their pre-signed URLs must stay on
# the endpoint host they were signed for. Leave blank while Cloudinary handles
# public images.
AWS_S3_CUSTOM_DOMAIN=

# ---- Payments: Paystack (required for paid courses) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://vaceup.ng/payment/callback
PAYMENT_CURRENCY=NGN

# ---- Live classes: LiveKit (optional; "external" link provider needs no keys) ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=
LIVE_CLASS_JOIN_EARLY_MINUTES=10
LIVE_CLASS_JOIN_GRACE_MINUTES=15

# ---- Monthly challenge: free inference is explicitly enabled after the pilot ----
# Keep this key on the backend only. Never put it in NEXT_PUBLIC_* variables.
GROQ_API_KEY=
CHALLENGE_AI_ENABLED=false
# Set true only after the representative assessment and capacity review.
CHALLENGE_ASSESSMENT_CALIBRATED=false
CHALLENGE_GROQ_MODEL=qwen/qwen3.8-27b
CHALLENGE_AI_DAILY_TOKEN_LIMIT=180000
CHALLENGE_AI_MAX_OUTPUT_TOKENS=1200
CHALLENGE_AI_TIMEOUT_SECONDS=45
# Public observations supplement submitted proof. Enable permitted_public_html
# only where automated collection is authorized; no social login is used.
CHALLENGE_PUBLIC_COUNTER_COLLECTOR=disabled
CHALLENGE_VERIFY_TTL_HOURS=48
CHALLENGE_SESSION_TTL_HOURS=24
CHALLENGE_MAX_PROJECT_BYTES=20971520
CHALLENGE_MAX_ENGAGEMENT_BYTES=10485760
CHALLENGE_MAX_REGISTRATIONS=10000
