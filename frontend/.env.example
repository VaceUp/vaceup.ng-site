# VaceUp Frontend Environment Variables
# Copy to .env.local for local development
# Set in Cloudflare Pages Dashboard > Settings > Environment variables for production

# API Configuration
NEXT_PUBLIC_API_URL=https://api.vaceup.ng/api/v1
NEXT_PUBLIC_WS_URL=wss://api.vaceup.ng/ws

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# LiveKit
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.vaceup.ng

# Feature Flags
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_WHITEBOARD=true
NEXT_PUBLIC_ENABLE_CODE_EDITOR=true
NEXT_PUBLIC_ENABLE_LIVE_CLASSES=true

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HOTJAR_ID=

# App Info
NEXT_PUBLIC_APP_NAME=VaceUp
NEXT_PUBLIC_APP_URL=https://vaceup.ng
NEXT_PUBLIC_API_URL=https://api.vaceup.ng/api/v1

# Cloudflare Pages Build Environment Variables (set in Cloudflare Dashboard > Pages > Settings > Environment variables)
# These are available at build time
# BACKEND_URL=https://api.vaceup.ng (for API proxy Worker)