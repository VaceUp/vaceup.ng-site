# Cloudflare Pages requires a path before every header block.
# connect-src must list the live-room hosts: the browser opens a socket to
# wss://*.livekit.cloud and fetches /rtc/validate from the same host. Without
# them the room is blocked on every network, and the client reports the block as
# "Failed to fetch" — the same words it uses when the internet is down.
#
# Permissions-Policy must also name meet.jit.si: a Jitsi room runs inside a
# frame, and the default camera=(self)/microphone=(self) gives that frame no
# camera and no microphone, so the room looks one-way.
#
# The Meta pixel is loaded on public pages only. Its loader comes from
# connect.facebook.net (script-src) and it reports back to connect.facebook.net
# and www.facebook.com (connect-src). Image beacons are covered by the https:
# entry in img-src. Remove these three origins and the pixel silently stops
# reporting — the ad account then shows clicks but no registrations.
#
# The practice code editor runs code online. cdn.jsdelivr.net serves Pyodide,
# sql.js and the React UMD builds; esm.sh serves the in-browser TypeScript/JSX
# compiler; ce.judge0.com runs Java, C++, Go and Rust on a public sandbox.
# 'wasm-unsafe-eval' is required to compile the Python and SQLite WebAssembly.
# worker-src allows the Python worker, and frame-src 'self' allows the srcdoc
# preview frames used for HTML, CSS, JavaScript and React output.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self "https://meet.jit.si"), microphone=(self "https://meet.jit.si"), display-capture=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.lordicon.com https://meet.jit.si https://connect.facebook.net https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.vaceup.ng wss://api.vaceup.ng https://*.livekit.cloud wss://*.livekit.cloud https://meet.jit.si https://cdn.lordicon.com https://*.r2.cloudflarestorage.com https://api.cloudinary.com https://connect.facebook.net https://www.facebook.com https://cdn.jsdelivr.net https://esm.sh https://ce.judge0.com; media-src 'self' blob: https:; frame-src 'self' https://js.paystack.co https://meet.jit.si; worker-src 'self' blob:; form-action 'self';

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/runners/*
  Cache-Control: public, max-age=86400

# Programme thumbnails, learner portraits and the hero photo, served from this
# origin instead of a photo CDN. A day of caching keeps them off the wire on
# return visits; the filenames are not hashed, so a day is also the longest a
# replaced photo can hide.
/img/*
  Cache-Control: public, max-age=86400

# The logo and academy marks change rarely. A day of browser caching stops
# them being re-validated on every navigation, while a replaced file still
# reaches visitors the next day.
/*.webp
  Cache-Control: public, max-age=86400

/*.png
  Cache-Control: public, max-age=86400

/*.ico
  Cache-Control: public, max-age=86400

/reset-password/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/verify-email/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# The verification code travels in the URL: never let it leak to a third party.
/verify/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# API CORS is enforced by Django, never by a wildcard here.
