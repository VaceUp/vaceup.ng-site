# Cloudflare Pages requires a path before every header block.
# connect-src must list the live-room hosts: the browser opens a socket to
# wss://*.livekit.cloud and fetches /rtc/validate from the same host. Without
# them the room is blocked on every network, and the client reports the block as
# "Failed to fetch" — the same words it uses when the internet is down.
#
# Permissions-Policy must also name meet.jit.si: a Jitsi room runs inside a
# frame, and the default camera=(self)/microphone=(self) gives that frame no
# camera and no microphone, so the room looks one-way.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self "https://meet.jit.si"), microphone=(self "https://meet.jit.si"), display-capture=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.lordicon.com https://meet.jit.si; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.vaceup.ng wss://api.vaceup.ng https://*.livekit.cloud wss://*.livekit.cloud https://meet.jit.si https://cdn.lordicon.com https://*.r2.cloudflarestorage.com https://api.cloudinary.com; media-src 'self' blob: https:; frame-src https://js.paystack.co https://meet.jit.si; form-action 'self';

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/reset-password/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/verify-email/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# The verification code travels in the URL: never let it leak to a third party.
/verify/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# API CORS is enforced by Django, never by a wildcard here.
