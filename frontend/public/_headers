# Cloudflare Pages requires a path before every header block.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.lordicon.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.vaceup.ng wss://api.vaceup.ng https://cdn.lordicon.com https://*.r2.cloudflarestorage.com https://api.cloudinary.com; media-src 'self' blob: https:; frame-src https://js.paystack.co; form-action 'self';

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/reset-password/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/verify-email/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# API CORS is enforced by Django, never by a wildcard here.
